{
  "name": "Pentair KiCad PCB",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=pentair-chatgpt-storage,target=/home/vscode/.vscode-server/data/User/globalStorage/openai.chatgpt,type=volume",
    "source=pentair-codex-home,target=/home/vscode/.codex,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "ms-vscode.powershell",
        "streetsidesoftware.code-spell-checker",
        "openai.chatgpt"
      ],
      "settings": {
        "files.associations": {
          "*.kicad_sch": "scheme",
          "*.kicad_pcb": "scheme",
          "*.kicad_sym": "scheme",
          "*.kicad_mod": "scheme"
        }
      }
    }
  },
  "postCreateCommand": "kicad-cli version || true",
  "remoteUser": "vscode"
}
